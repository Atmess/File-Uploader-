<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader - My Drive</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f8f9fa; }
        .flex-row { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; }
        .folder-card, .file-card { background: white; padding: 16px; border: 1px solid #ddd; border-radius: 8px; max-width: 220px; }
        .modal-box { background: #fff; padding: 12px; border: 1px solid #ccc; margin-top: 8px; border-radius: 6px; }
        .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; }
        .alert-error { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .alert-success { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
    </style>
</head>
<body>
    <header>
        <a href="/"><h1 style="color: #333;">File Uploader</h1></a>
        <nav>
            <% if (locals.user) { %>
                <span>Welcome, <%= user.username %>!</span>
                <div style="margin-bottom: 20px;">
                    <a href="/" style="text-decoration: none; font-size: 18px; font-weight: bold; color: #007bff;">
                        My Drive (Home)
                    </a>
                </div>
                <a href="/log-out">Log Out</a>
            <% } else { %>
                <a href="/log-in">Log In</a>
                <a href="/register">Sign Up</a>
            <% } %>
        </nav>
    </header>

    <main>
        <!-- Flash Messages Display Block -->
        <% if (locals.error && locals.error.length > 0) { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

        <% if (locals.success && locals.success.length > 0) { %>
            <div class="alert alert-success">
                <%= success %>
            </div>
        <% } %>

        <% if (locals.user) { %>
            <section>
                <h2>Your Dashboard</h2>
                
                <div class="actions">
                    <button id="createFolderbtn" onclick="
                        document.getElementById('createFolder').style.display='block';
                        this.style.display='none';
                        document.getElementById('uploadFile').style.display='none';
                        document.getElementById('uploadFilebtn').style.display='inline-block';
                    ">Create New Folder</button>

                    <button id="uploadFilebtn" onclick="
                        document.getElementById('uploadFile').style.display='block';
                        this.style.display='none';
                        document.getElementById('createFolder').style.display='none';
                        document.getElementById('createFolderbtn').style.display='inline-block';
                    ">Upload File</button>
                </div>

                <div style="margin-top: 12px;">
                    <!-- Create Folder Form -->
                    <form action="/folders/new" method="POST" id="createFolder" style="display: none;">
                        <label for="foldername">Folder Name:</label>
                        <input type="text" id="foldername" name="foldername" required>
                        <button type="submit">Create</button>
                    </form>

                    <!-- Upload File Form -->
                    <form action="/upload/<%= locals.currentFolderId || '' %>" method="POST" enctype="multipart/form-data" id="uploadFile" style="display: none;">
                        <input type="file" name="upload" id="upload" required><br><br>
                        <button type="submit">Upload</button>
                    </form>
                </div>

                <div class="content">
                    <h3>Folders</h3>
                    <div class="flex-row">
                        <!-- Home link -->
                        <div class="folder-card">
                            <a href="/" style="text-decoration: none; color: #007bff;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="#FFD700" stroke="#B8860B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                </svg>
                                <div><strong>Home</strong></div>
                            </a>
                        </div>

                        <!-- Folder List -->
                        <% if (locals.folders && folders.length > 0) { %>
                            <% folders.forEach((folder) => { %>
                                <div class="folder-card">
                                    <a href="/folder/<%= folder.id %>" style="text-decoration: none; color: #333;">
                                        <svg width="48" height="48" viewBox="0 0 24 24" fill="#FFD700" stroke="#B8860B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                        <div style="word-break: break-all; font-weight: bold;"><%= folder.name %></div>
                                    </a>

                                    <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 4px;">
                                        <!-- Edit Folder Name -->
                                        <button type="button" onclick="
                                            const f = document.getElementById('editFolderForm-<%= folder.id %>');
                                            f.style.display = f.style.display === 'none' ? 'block' : 'none';
                                        ">Rename</button>

                                        <form action="/editname/<%= folder.id %>" method="POST" id="editFolderForm-<%= folder.id %>" style="display: none;" class="modal-box">
                                            <input type="text" name="editname" value="<%= folder.name %>" required>
                                            <button type="submit">Save</button>
                                        </form>

                                        <!-- Share Folder -->
                                        <button type="button" onclick="
                                            const s = document.getElementById('shareModal-<%= folder.id %>');
                                            s.style.display = s.style.display === 'none' ? 'block' : 'none';
                                        ">Share</button>

                                        <div id="shareModal-<%= folder.id %>" style="display: none;" class="modal-box">
                                            <form action="/folders/<%= folder.id %>/share" method="POST">
                                                <label for="duration-<%= folder.id %>">Expires in:</label>
                                                <select name="duration" id="duration-<%= folder.id %>" required>
                                                    <option value="1h">1 Hour</option>
                                                    <option value="1d" selected>1 Day</option>
                                                    <option value="7d">7 Days</option>
                                                    <option value="30d">30 Days</option>
                                                </select>
                                                <button type="submit">Generate Link</button>
                                            </form>
                                        </div>

                                        <!-- Delete Folder -->
                                        <form action="/deletefolder/<%= folder.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this folder?');">
                                            <button type="submit" style="color: red; width: 100%;">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <h3>Files</h3>
                    <% if (locals.files && files.length > 0) { %>
                        <div class="flex-row">
                            <% files.forEach((file) => { %>
                                <div class="file-card">
                                    <a href="/file/<%= file.id %>">
                                        <img src="<%= file.url %>" alt="<%= file.name %>" style="width: 100%; height: 140px; object-fit: cover; border-radius: 4px;">
                                        <p style="word-break: break-all;"><strong><%= file.name %></strong></p>
                                    </a>
                                    
                                    <small><%= new Date(file.uploadTime).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></small>

                                    <div style="margin-top: 10px; display: flex; flex-direction: column; gap: 4px;">
                                        <!-- Download -->
                                        <a href="/download/<%= file.id %>"><button type="button" style="width: 100%;">Download</button></a>

                                        <!-- Move File -->
                                        <button type="button" onclick="
                                            const m = document.getElementById('movefileform<%= file.id %>');
                                            m.style.display = m.style.display === 'none' ? 'block' : 'none';
                                        ">Move</button>

                                        <form action="/movefile/<%= file.id %>" method="POST" id="movefileform<%= file.id %>" style="display: none;" class="modal-box">
                                            <select name="toFolder">
                                                <option value="">Home folder</option>
                                                <% if (locals.folders) { %>
                                                    <% folders.forEach((folder) => { %>
                                                        <option value="<%= folder.id %>"><%= folder.name %></option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                            <button type="submit">Move</button>
                                        </form>

                                        <!-- Edit File Name -->
                                        <button type="button" onclick="
                                            const e = document.getElementById('editfilename<%= file.id %>');
                                            e.style.display = e.style.display === 'none' ? 'block' : 'none';
                                        ">Rename</button>

                                        <form action="/editfilename/<%= file.id %>" method="POST" id="editfilename<%= file.id %>" style="display: none;" class="modal-box">
                                            <input type="text" name="editfilename" value="<%= file.name %>" required>
                                            <button type="submit">Save</button>
                                        </form>

                                        <!-- Delete File -->
                                        <form action="/deletefile/<%= file.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this file?');">
                                            <button type="submit" style="color: red; width: 100%;">Delete</button>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <p>No files in this folder.</p>
                    <% } %>
                </div>
            </section>
        <% } else { %>
            <section>
                <h2>Store your files securely in the cloud.</h2>
                <p>Create an account to start uploading your files and organizing them into folders.</p>
                <button type="button" onclick="
                document.getElementById('testAcc').style.display='inline'
                ">Use Test Account</button>
                <div id="testAcc" style="display: none;">
                    <p>to test you can use</p> 
                    <p>Username : testAcc </p>
                    <p>Password : 1234567890</p> 
                </div>
                <a href="/register"><button>Get Started</button></a>
            </section>
        <% } %>
    </main>
</body>
</html>